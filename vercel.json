{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/vote",          "destination": "/api/vote" },
    { "source": "/api/vote-scores",   "destination": "/api/vote-scores" },
    { "source": "/api/submit-comp",   "destination": "/api/submit-comp" },
    { "source": "/api/pending-comps", "destination": "/api/pending-comps" },
    { "source": "/",                  "destination": "/dist/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "Referrer-Policy",          "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
